<mxfile host="app.diagrams.net" modified="2026-07-21T00:00:00.000Z" agent="asl-to-drawio" version="24.0.0" type="device">
  <diagram id="handle-filemanager" name="Handle Filemanager">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Start -->
        <mxCell id="n1" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1a1a1a;strokeWidth=2;fontSize=13;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="147" y="30" width="56" height="36" as="geometry"/>
        </mxCell>
        <!-- Update filemanager attributes -->
        <mxCell id="n2" value="&lt;b&gt;Update filemanager attributes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555555&quot;&gt;Tag output files with portalRunId&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="25" y="118" width="300" height="62" as="geometry"/>
        </mxCell>
        <!-- Filemanager sync check -->
        <mxCell id="n3" value="&lt;b&gt;Check filemanager sync&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555555&quot;&gt;Compare ICAv2 file count vs filemanager&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="25" y="228" width="300" height="62" as="geometry"/>
        </mxCell>
        <!-- Decision: Is synced -->
        <mxCell id="n4" value="Files&lt;br&gt;synced?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="55" y="338" width="240" height="62" as="geometry"/>
        </mxCell>
        <!-- Wait -->
        <mxCell id="n5" value="&lt;b&gt;Wait 60 seconds&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555555&quot;&gt;Retry up to 60 times (1 hour max)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="450" y="228" width="300" height="62" as="geometry"/>
        </mxCell>
        <!-- Success -->
        <mxCell id="n6" value="Success" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="448" width="200" height="46" as="geometry"/>
        </mxCell>
        <!-- Failure -->
        <mxCell id="n7" value="Failure" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="448" width="200" height="46" as="geometry"/>
        </mxCell>
        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="n1" target="n2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="n3" target="n4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Synced yes -->
        <mxCell id="e4" value="synced" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;fontSize=10;fontStyle=2;fontColor=#888888;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="n4" target="n6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Not synced - wait and retry -->
        <mxCell id="e5" value="not synced" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;fontColor=#888888;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="n4" target="n5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Wait loops back to Update attributes -->
        <mxCell id="e6" value="retry" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;fontColor=#888888;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="n5" target="n2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="149"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Timeout failure -->
        <mxCell id="e7" value="timeout" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;fontColor=#888888;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="n5" target="n7" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="420"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
